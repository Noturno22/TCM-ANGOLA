# Credenciais para os testes e2e ONLINE (backend Supabase real).
#
# Copia este ficheiro para `.env.e2e` (IGNORADO pelo git) e preenche os valores.
# NUNCA commites `.env.e2e` — contém a chave de serviço (service role).
#
# Obtém os valores:
#   * URL e chave publishable: Supabase Dashboard → Project Settings → API.
#   * Service role key:        Supabase Dashboard → Project Settings → API (secret).
#
# Depois corre:  bun run e2e:online

# URL do projeto (ex.: https://xxxxxxxxxxxx.supabase.co)
E2E_SUPABASE_URL=

# Chave pública (publishable / anon) — usada pelo browser da app.
E2E_SUPABASE_PUBLISHABLE_KEY=

# Chave de serviço (service role / secret) — só para criar utilizadores de teste.
# NUNCA colocar no cliente nem em código commitado.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Opcional: personalizar emails/password dos utilizadores de teste efémeros.
# E2E_USER1_EMAIL=e2e-player-1@tira.test
# E2E_USER2_EMAIL=e2e-player-2@tira.test
# E2E_TEST_PASSWORD=E2e-Test-Passw0rd!
