# ---------------------------------------------------------------------
# Copia este ficheiro para `.env` e preenche com os teus valores.
# O `.env` está no .gitignore e nunca deve ser commitado.
# ---------------------------------------------------------------------

# Base de dados local (Prisma/SQLite) — legado
DATABASE_URL=file:./db/custom.db

# --- Supabase (backend de autenticação e dados) ---
# Dashboard → Project Settings → API
# URL do projeto (ex.: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key (segura para o browser; NÃO uses a service_role key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (usada em metadata/SEO e redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pagamentos (depósitos e levantamentos manuais) ---
# Chave-mestra do dinheiro real (D6). `true` = depósitos e levantamentos
# manuais com comprovativo ficam visíveis e ligados ao backend.
# O backend usa o segredo equivalente `REAL_MONEY_ENABLED` (Edge Functions).
NEXT_PUBLIC_REAL_MONEY_ENABLED=true

# Providers de depósito ativos na UI (lista separada por vírgulas).
# `appypay` = depósitos automáticos (requer segredos APPYPAY_* nas Edge
# Functions + webhook configurado no portal AppyPay — ver
# `supabase/functions/PAYMENTS.md`). `mock` = sandbox (NUNCA em produção).
# Só tem efeito com `NEXT_PUBLIC_REAL_MONEY_ENABLED=true`.
NEXT_PUBLIC_PAYMENTS_ENABLED_PROVIDERS=mock

# Levantamentos na UI (`true` para mostrar; requer KYC aprovado no servidor).
# Requer a chave-mestra ligada e `PAYOUTS_ENABLED=true` na Edge Function.
NEXT_PUBLIC_PAYOUTS_ENABLED=true

# Emails com acesso ao painel admin de depósitos/levantamentos (lista
# separada por vírgulas). O backend usa o segredo equivalente `ADMIN_EMAILS`
# (Edge Function `admin-manage`); o cliente só decide se mostra ou esconde a UI.
NEXT_PUBLIC_ADMIN_EMAILS=

# --- Send SMS Hook (Supabase Auth -> WhatsApp Cloud API) ---
# Só necessário para `supabase functions serve`. Em produção são segredos da função.
# Segredo gerado no dashboard: Authentication -> Hooks -> Send SMS
SUPABASE_AUTH_HOOK_SECRET=
# WhatsApp Cloud API (Meta) — sem Twilio
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# (opcional) template aprovado pela Meta para OTP fora da janela de 24h
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_PT
WHATSAPP_API_VERSION=v21.0
