{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@tira/engine": [
        "../../packages/engine/src/index.ts"
      ],
      "@tira/ai": [
        "../../packages/ai/src/index.ts"
      ],
      "@tira/engine/*": [
        "../../packages/engine/src/*"
      ],
      "@tira/ai/*": [
        "../../packages/ai/src/*"
      ],
      "@tira/design-tokens": [
        "../../packages/design-tokens/src/index.ts"
      ],
      "@tira/i18n": [
        "../../packages/i18n/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}